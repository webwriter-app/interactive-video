  },
  "editingConfig": {
    ".": {},
    "./widgets/webwriter-video-interaction": {
      "draggable": false,
      "definingForContent": true,
      "isolating": true,
      "content": "(flow)*",
      "uninsertable": true
    },
    "./widgets/webwriter-interactive-video": {
      "draggable": false,
      "definingAsContext": true,
      "content": "(webwriter-video-interaction)*"
    }
